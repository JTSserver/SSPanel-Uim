# Database
DATABASE_URL=postgres://casino:casino@localhost:5432/casino

# Redis (sessions, rate limiting, game state)
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=replace-with-32-byte-random-hex
SESSION_TTL_SECONDS=3600

# Provably-fair seed rotation
SERVER_SEED_ROTATION_ROUNDS=10000

# CZ regulator (AISG) — Ministerstvo financí
CZ_AISG_ENDPOINT=
CZ_AISG_OPERATOR_ID=
CZ_AISG_CERT_PATH=
CZ_EXCLUSION_REGISTRY_ENDPOINT=

# SK regulator (ÚRHH)
SK_URHH_ENDPOINT=
SK_URHH_OPERATOR_ID=
SK_URHH_CERT_PATH=
SK_EXCLUSION_REGISTRY_ENDPOINT=

# KYC provider (Sumsub / Veriff / Onfido — pick one)
KYC_PROVIDER=sumsub
KYC_API_KEY=
KYC_WEBHOOK_SECRET=

# Crypto deposits — read-only RPC + watched chains
RPC_ETH=
RPC_BTC=
HOT_WALLET_ADDRESS_ETH=
HOT_WALLET_ADDRESS_BTC=
DEPOSIT_CONFIRMATIONS_ETH=12
DEPOSIT_CONFIRMATIONS_BTC=3

# Fiat — bank/PSP for CZK and EUR
PSP_PROVIDER=
PSP_API_KEY=
